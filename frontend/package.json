{
  "name": "mufus-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint src",
    "test": "vitest run --environment jsdom",
    "format:check": "prettier --check src index.html vite.config.ts",
    "format": "prettier --write src index.html vite.config.ts",
    "tauri": "cd .. && tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "8.3.8",
    "vitest": "^5.1.0"
  }
}
